{
  "name": "plex-employees",
  "version": "0.1.0",
  "license": "None provided",
  "private": true,
  "dependencies": {
    "body-parser": "^1.18.3",
    "bookshelf": "^0.14.2",
    "bootstrap": "^4.2.1",
    "concurrently": "^3.6.0",
    "cors": "^2.8.4",
    "dompurify": "^3.3.0",
    "dotenv": "^17.2.3",
    "express": "^4.16.3",
    "express-rate-limit": "^8.2.1",
    "font-awesome": "^4.7.0",
    "joi": "^17.0.2",
    "joi-browser": "^13.4.0",
    "knex": "^0.16.3",
    "lodash": "^4.17.11",
    "morgan": "^1.10.1",
    "nodemon": "^1.17.5",
    "prop-types": "^15.8.1",
    "react": "^16.4.1",
    "react-dom": "^16.4.1",
    "react-router-dom": "^4.3.1",
    "react-scripts": "5.0.1",
    "seeds-random": "2.3.7",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.0",
    "winston": "^3.18.3"
  },
  "scripts": {
    "start": "concurrently --kill-others \"node --inspect server \" \"cross-env PORT=3000 npm run start:react-app\"",
    "start:react-app": "react-scripts start",
    "build": "react-scripts build",
    "test:client": "react-scripts test --watchAll=false",
    "coverage:client": "npm run test:client --coverage",
    "test:server": "cd server && jest --config ../jest.server.config.js",
    "coverage:server": "npm run test:server --coverage",
    "test:integration": "jest --config jest.integration.config.js",
    "test": "npm run test:client && npm run test:server",
    "eject": "react-scripts eject",
    "custom:build": "nodemon src/scripts/build.js --watch src/data --ext .md",
    "custom:start": "concurrently --kill-others \"npm run custom:build\" \"npm run start\"",
    "prepare": "node server/seed.js || echo 'Skipping prepare'"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "5",
    "@testing-library/react": "^12.1.5",
    "babel-jest": "^30.2.0",
    "cross-env": "^10.1.0",
    "supertest": "^7.1.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
